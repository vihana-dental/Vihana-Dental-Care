{
  "version": "7.3",
  "screens": [
    {
      "id": "DATE",
      "title": "Choose your date",
      "terminal": true,
      "success": true,
      "data": {
        "min_date": { "type": "string", "__example__": "2026-09-25" },
        "max_date": { "type": "string", "__example__": "2026-11-24" },
        "unavailable_dates": { "type": "array", "items": { "type": "string" }, "__example__": ["2026-09-27"] }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Book with Dr. N. Sanchana" },
          { "type": "TextBody", "text": "Pick the day you'd like to visit. Open times for that day are shown next." },
          {
            "type": "DatePicker",
            "name": "date",
            "label": "Appointment date",
            "required": true,
            "min-date": "${data.min_date}",
            "max-date": "${data.max_date}",
            "unavailable-dates": "${data.unavailable_dates}"
          },
          {
            "type": "Footer",
            "label": "Show available times",
            "on-click-action": {
              "name": "complete",
              "payload": { "date": "${form.date}" }
            }
          }
        ]
      }
    }
  ]
}
