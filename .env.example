# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps display.
GOOGLE_MAPS_PLATFORM_KEY=""

# GOOGLE_PLACES_API_KEY: Required for live Google Reviews (Places API "New" must be
# enabled on this key's GCP project). Falls back to GOOGLE_MAPS_PLATFORM_KEY if unset,
# provided Places API is also enabled on that key.
GOOGLE_PLACES_API_KEY=""

# GOOGLE_PLACE_ID: The Place ID for this business listing (find it via
# https://developers.google.com/maps/documentation/places/web-service/place-id).
# Without this, the Reviews section falls back to the curated static reviews.
GOOGLE_PLACE_ID=""

# ---------------- Razorpay (appointment booking payments) ----------------
# Without these, /api/payments/* and /api/razorpay/* endpoints run in mock
# mode: orders, payment links, and QR codes are still generated and the full
# checkout UX (including signature "verification") works end-to-end against
# fake IDs, so the flow can be exercised before live keys exist.

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: from the Razorpay Dashboard
# (Settings > API Keys). Key ID is safe for the client; the secret must
# stay server-side only (already enforced — it's never sent to the browser).
# Used to create orders and to HMAC-verify the Standard Checkout callback
# signature in POST /api/payments/verify.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: set when configuring a webhook in the Razorpay
# Dashboard (Settings > Webhooks > add endpoint https://<your-domain>/api/payments/webhook,
# subscribe to BOTH "payment.captured" and "payment_link.paid"). Used to
# HMAC-verify the webhook payload in POST /api/payments/webhook — the
# fallback that confirms a booking even if the frontend's /verify call never
# lands (closed tab, dropped network), and the *only* confirmation path for
# the chatbot and WhatsApp channels, which use payment links, not the
# Standard Checkout popup. Without this set, the webhook accepts unsigned
# events (dev/mock only — must be set before go-live).
RAZORPAY_WEBHOOK_SECRET=""

# ---------------- Supabase (patient CRM) ----------------
# Additive alongside the existing booking system — Google Calendar remains
# the scheduling source of truth; Supabase is a deduplicated patient record
# store, checked/updated on every confirmed booking across all 3 channels.
# Without these, patient upserts run in mock mode (logged, not written) —
# bookings still complete normally either way (see recordConfirmedAppointment
# in server.ts — a Supabase outage never blocks a confirmed booking).
#
# Setup: supabase.com > New project > SQL Editor > run supabase/schema.sql >
# Project Settings > API > copy the Project URL and the service_role key
# (NOT the anon/public key — service_role bypasses Row Level Security, which
# is required since this app writes from a trusted server, not a browser).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------- Google Sheets (appointment log) ----------------
# A human-readable appointment export, additive alongside Calendar — appended
# to on every confirmed booking across all 3 channels. Authenticated via
# OAuth, reusing the SAME GOOGLE_OAUTH_CLIENT_ID/SECRET/REDIRECT_URI and
# GOOGLE_CALENDAR_REFRESH_TOKEN as Google Calendar above — no separate
# credential needed. (A service account was tried first here; it lived in a
# different, now-inaccessible Google Cloud project once the client's account
# took over the app, and Google scopes API-enablement to the *calling
# credential's* project, not the target spreadsheet — so it could never work
# once ownership moved. OAuth as the real account sidesteps that.)
#
# Only GOOGLE_SHEETS_SPREADSHEET_ID is new here — copy it from the sheet's
# URL (.../d/<THIS_PART>/edit). If that sheet is owned by the same Google
# account that clicks "Connect Google Calendar" in /doctor-admin, no sharing
# step is needed at all. Without this set, row appends run in mock mode.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_TAB_NAME="Appointments"

# ---------------- Meta WhatsApp Business API (Module A) ----------------
# Its own separate onboarding: Meta Developer App + WhatsApp Business
# Account + a verified phone number — ask when you're ready to set this up,
# it's a multi-step process similar in shape to the Google OAuth one above.
# Without these, the webhook conversation flow (slot picking, Razorpay QR
# generation) runs fully in mock mode — every "send" is logged instead of
# actually delivered, so the flow can be tested via curl before Meta access
# exists.
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_ACCESS_TOKEN=""

# You choose this string yourself (any random value) when registering the
# webhook URL in the Meta App Dashboard — Meta echoes it back during the
# one-time verification handshake (GET /api/whatsapp/webhook).
META_WHATSAPP_VERIFY_TOKEN=""

# From the Meta App Dashboard > App Settings > Basic > App Secret. Used to
# HMAC-verify the X-Hub-Signature-256 header on every incoming webhook POST —
# without this set, the webhook accepts unsigned payloads (dev/mock only;
# an unverified webhook in production accepts requests from anyone who finds
# the URL, so this MUST be set before going live).
META_WHATSAPP_APP_SECRET=""

# META_WHATSAPP_DISPLAY_NUMBER: the clinic's patient-facing WhatsApp number,
# digits only (no "+", no spaces) — e.g. "919876543210". Used to build the
# wa.me click-to-chat links shown on every booking confirmation screen
# (website CTA, chatbot, WhatsApp bot itself) so the patient can tap through
# to a pre-filled "Show my appointment details #<id>" message. This is what
# makes those confirmations patient-initiated rather than business-initiated
# — the business only replies once the patient sends that message, which
# opens a normal 24h session, no template required. Falls back to
# CLINIC_INFO.whatsapp (src/data/clinicData.ts) if left blank, which still
# produces a working link but opens a plain chat rather than the bot flow
# until this is set to the actual Meta-registered number.
META_WHATSAPP_DISPLAY_NUMBER=""

# ---------------- Google Calendar + Meet (appointment sync) ----------------
# Authenticated via OAuth 2.0 as the doctor's real Google account — NOT a
# service account. Service accounts are hard-blocked by Google from inviting
# attendees and from creating Meet conferences unless the calendar is on a
# paid Google Workspace with domain-wide delegation configured (confirmed
# against a live personal Gmail calendar during development). OAuth acting as
# a real user has neither restriction.
#
# Without these, appointments/availability/Meet links all run in mock mode
# so the booking flow and UI states can be fully exercised.
#
# Setup:
#   1. Cloud Console > APIs & Services > OAuth consent screen — User type:
#      External, add scope https://www.googleapis.com/auth/calendar, add
#      the doctor's Google account as a test user, then Publish App (avoids
#      refresh tokens expiring after 7 days while still in Testing).
#   2. Cloud Console > APIs & Services > Credentials > Create Credentials >
#      OAuth client ID > Web application. Add an Authorized redirect URI
#      matching GOOGLE_OAUTH_REDIRECT_URI below exactly.
#   3. Paste the resulting Client ID/Secret below, restart the server, then
#      log into /doctor-admin and click "Connect Google Calendar" — this
#      does a one-time consent as the doctor's account and returns a
#      refresh token to paste into GOOGLE_CALENDAR_REFRESH_TOKEN.
#
# Swapping to the client's calendar later = they click "Connect Google
# Calendar" in /doctor-admin with their own account. GOOGLE_OAUTH_CLIENT_ID/
# SECRET don't change (they identify this app, not any particular user).

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/admin/google-oauth-callback"

# Populated by the one-time "Connect Google Calendar" flow above — leave
# blank until then.
GOOGLE_CALENDAR_REFRESH_TOKEN=""

# The calendar to read/write — copy from Google Calendar > Settings >
# [calendar] > Integrate calendar > Calendar ID.
GOOGLE_CALENDAR_ID=""

# Clinic timezone used for all working-hours and freebusy calculations.
GOOGLE_CALENDAR_TIMEZONE="Asia/Kolkata"

# ---------------- Doctor Admin (fee editing) ----------------
# DOCTOR_ADMIN_PIN: PIN required to log in at /doctor-admin and edit the
# advance booking fee. Change this from the default before going live.
DOCTOR_ADMIN_PIN="2468"
